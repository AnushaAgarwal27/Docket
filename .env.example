# Copy to .env. Never commit real keys.

ANTHROPIC_API_KEY=
CONVEX_URL=

# ---- Agent seeds -------------------------------------------------------------
# An agent's Agentverse address is derived from its seed, so these must not change once the agent
# is registered. Generate the ones you are missing: python -m scripts.make_seeds
COORDINATOR_SEED=
LEDGER_SEED=
TAX_SEED=
CASEWORKER_SEED=
RESEARCHER_SEED=
AUDITOR_SEED=
ORGANIZER_SEED=
FILER_SEED=

# ---- Sponsors ----------------------------------------------------------------
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=          # optional; seed.reset writes .nessie_ids.json instead
APIFY_TOKEN=
# Agentverse API key (profile menu -> API Keys), used by scripts/connect_mailboxes.py
AGENTVERSE_API_KEY=
# ASI:One, for Athena deep research (asi1.ai -> API Keys). Without it the research agent falls
# back to Claude with web search; with it, the agentic models plan the research and can call
# other agents on Agentverse.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1-agentic  # or asi1-extended-agentic for longer multi-stage research

# ---- Voice (docs/CARTESIA.md) ------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_FROM_NUMBER_ID=      # a phone number on the Cartesia account; the caller id for both agents
CARTESIA_AGENT_ID=            # the agent that calls payroll
CARTESIA_STUDENT_AGENT_ID=    # the student line: Docket calls her, and she can call it back
PAYROLL_PHONE=                # who the payroll request is for, E.164. Only rings if the demo redirect is off.
CARTESIA_TOOL_TOKEN=          # same value as `npx convex env set CARTESIA_TOOL_TOKEN`
CARTESIA_SIMULATE=            # 1 = rehearsal: no phone call, payroll follows the case's rehearsal setting

# Demo call routing. While DEMO_CALL_REDIRECT is on, DEMO_CALL_NUMBER is the ONLY phone that rings,
# whoever the call is for. The real number still travels with the call and is shown on the dashboard,
# so a redirected call is visible rather than silently going somewhere else. Set DEMO_CALL_REDIRECT=0
# to dial real numbers, and read the consent and calling-hours notes in docs/CARTESIA.md first.
DEMO_CALL_NUMBER=+19259677432
DEMO_CALL_REDIRECT=1

# ---- Tuning (all optional) ---------------------------------------------------
DEMO_PROFILE_NAME=Priya Sharma
UNIVERSITY_DOMAINS=berkeley.edu   # extra domains a quote may be verified against
RESEARCH_WATCH_SECONDS=900        # how often Athena re-reads the news for this student's rules
RESEARCH_ASK_SECONDS=20           # how quickly a question taken on a call gets answered
ORGANIZER_POLL_SECONDS=60
FILER_POLL_SECONDS=30
NOTIFY_POLL_SECONDS=10            # how often the Coordinator delivers queued chat messages
CASEWORKER_POLL_SECONDS=5
# This machine's Coordinator; eval/scenarios.py falls back to a teammate's address without it
COORDINATOR_ADDRESS=
